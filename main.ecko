# struct - pack and unpack binary data with a format string, over `bytes`.
#
#   import struct
#
#   b = struct.pack(">IHB", [65536, 256, 7])   # big-endian: u32, u16, u8
#   [a, b2, c] = struct.unpack(">IHB", b)       # -> [65536, 256, 7]
#
# A format is an optional endian prefix - `>` big-endian (the default), `<`
# little-endian, `!` network (big) - followed by type codes:
#
#   b/B  int8 / uint8      h/H  int16 / uint16
#   i/I  int32 / uint32    q/Q  int64 / uint64      x  pad byte
#
# Lowercase is signed, uppercase unsigned. Pure Ecko over the `bytes` type and
# the word operators (band/shl/shr/bor); no capabilities.
#
# Note: Ecko's Int is i64, so a `Q` (uint64) value above i64::MAX comes back
# negative (its raw bit pattern) - the one place the abstraction leaks.

WIDTH = { b: 1, B: 1, h: 2, H: 2, i: 4, I: 4, q: 8, Q: 8, x: 1 }

fn code_info(c) {
    w = get(WIDTH, c)
    if w == null { error({ kind: "value", message: "struct: unknown format code '{c}'" }) }
    { width: w, signed: contains("bhiq", c), pad: c == "x" }
}

fn parse_fmt(fmt) {
    cs = chars(fmt)
    mut big = true
    mut i = 0
    if len(cs) > 0 {
        c0 = cs[0]
        if c0 == "<" {
            big = false
            i = 1
        } else if c0 == ">" or c0 == "!" {
            big = true
            i = 1
        }
    }
    mut codes = []
    while i < len(cs) {
        codes = push(codes, code_info(cs[i]))
        i = i + 1
    }
    { big: big, codes: codes }
}

# The little-endian byte list for n across nbytes; reversed for big-endian.
# `band 255` extracts each byte and `shr 8` (arithmetic) advances - correct
# two's-complement for negatives.
fn int_bytes(n, nbytes, big) {
    mut bs = []
    mut v = n
    mut i = 0
    while i < nbytes {
        bs = push(bs, v band 255)
        v = v shr 8
        i = i + 1
    }
    if big { reverse(bs) } else { bs }
}

# Read an integer of nbytes from `data` at `offset`. Bitwise ops wrap in Ecko,
# so building an 8-byte value yields the exact i64 bit pattern.
fn read_int(data, offset, nbytes, big, signed) {
    mut v = 0
    mut i = 0
    while i < nbytes {
        idx = if big { offset + i } else { offset + nbytes - 1 - i }
        v = v shl 8 bor data[idx]
        i = i + 1
    }
    if signed and nbytes < 8 {
        half = 1 shl (nbytes * 8 - 1)
        if v >= half { v - (1 shl (nbytes * 8)) } else { v }
    } else { v }
}

# pack(fmt, values) -> bytes.
export fn pack(fmt, values) {
    p = parse_fmt(fmt)
    mut out = bytes([])
    mut vi = 0
    for code in p.codes {
        if code.pad { out = out + bytes([0]) } else {
            out = out + bytes(int_bytes(values[vi], code.width, p.big))
            vi = vi + 1
        }
    }
    out
}

# unpack(fmt, data) -> [values].
export fn unpack(fmt, data) {
    p = parse_fmt(fmt)
    mut out = []
    mut offset = 0
    for code in p.codes {
        if code.pad { offset = offset + 1 } else {
            out = push(out, read_int(data, offset, code.width, p.big, code.signed))
            offset = offset + code.width
        }
    }
    out
}

# sizeof(fmt) -> total byte count.
export fn sizeof(fmt) {
    p = parse_fmt(fmt)
    mut total = 0
    for code in p.codes {
        total = total + code.width
    }
    total
}
